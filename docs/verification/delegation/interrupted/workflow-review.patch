+  const r = await fetch(`${hh.url}${p}`, { method, headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' }, body: method === 'GET' ? undefined : JSON.stringify(body ?? {}) });
+  return { status: r.status, body: (await r.json()) as T };
