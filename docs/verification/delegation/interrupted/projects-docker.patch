+      {pending.decision && <><button className="btn primary" disabled={busy || left === 0} onClick={() => onResolve('approve')}>Approve and run</button><button className="btn" disabled={busy} onClick={() => onResolve('deny')}>Deny</button></>}
+      {onTerminal && <button className="btn sm" onClick={() => onTerminal(command)}>Open in terminal</button>}
