@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: Apache-2.0
+// Git for project intake: hooks, fsmonitor, credential prompts and user/system config are disabled
+// so inspecting a folder can never execute repository-controlled code.
+import { run, type ExecResult } from '../exec.ts';
+
+export const SAFE_GIT_FLAGS = ['-c', 'core.hooksPath=/dev/null', '-c', 'core.fsmonitor=false', '-c', 'credential.helper=', '-c', 'protocol.ext.allow=never'];
+
+export function safeGitEnv(extra: Record<string, string> = {}): NodeJS.ProcessEnv {
+  return { PATH: process.env.PATH, HOME: process.env.HOME, LC_ALL: 'C', GIT_TERMINAL_PROMPT: '0', GIT_OPTIONAL_LOCKS: '0', GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: '/dev/null', GIT_NO_LAZY_FETCH: '1', ...extra };
+}
+
+export function safeGit(cwd: string, args: string[], o: { timeoutMs?: number; maxBytes?: number } = {}): Promise<ExecResult> {
+  return run('git', [...SAFE_GIT_FLAGS, ...args], { cwd, env: safeGitEnv(), timeoutMs: o.timeoutMs ?? 20_000, maxBytes: o.maxBytes ?? 1024 * 1024 });
+}
