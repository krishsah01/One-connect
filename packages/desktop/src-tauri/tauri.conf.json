{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "One Connect",
  "version": "0.1.0",
  "identifier": "dev.agentcontrolcenter.desktop",
  "build": { "frontendDist": "../../web/dist" },
  "app": {
    "windows": [{ "label": "main", "title": "One Connect", "width": 1440, "height": 900, "minWidth": 760, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; font-src 'self' data:; object-src 'none'; frame-src 'none'" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "resources": ["resources/engine.tar.gz"], "macOS": { "minimumSystemVersion": "12.0" } }
}
